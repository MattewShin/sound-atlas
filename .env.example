# 서버 전용. VITE_ 접두사를 붙이지 마세요.
# Vercel에서도 서버 환경변수에 등록하세요.
KOPIS_SERVICE_KEY=
# 서버 전용 영구 캐시. 기존 Supabase 프로젝트의 서버 키만 사용합니다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 브라우저 공개 설정. Supabase Dashboard의 Project URL과 publishable key만 사용합니다.
# service_role key와 Google Client Secret에는 절대 VITE_ 접두사를 붙이지 마세요.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# 기존 anon key 기반 환경에서는 아래 공개 키 별칭도 지원합니다. publishable key가 우선합니다.
# VITE_SUPABASE_ANON_KEY=
# 공연 캐시는 fresh 6시간 / 갱신 실패 시 최대 24시간으로 고정됩니다.
PORT=3000
HOST=0.0.0.0
