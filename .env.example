# 서버 전용. 비밀키에 VITE_ 접두사를 붙이지 마세요.
# KOPIS: 기존 웹 검색 서버와 로컬 수집 CLI에서 사용합니다.
# 웹 배포는 Vercel 환경변수에도 KOPIS_SERVICE_KEY를 등록하고 재배포하세요.
KOPIS_SERVICE_KEY=
# Supabase: 로컬 수집·OCR·프로그램 분석 및 서버 DB 검색에서 사용합니다.
# Project URL과 서버 service_role JWT 또는 sb_secret_ 키를 입력합니다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server/local rollout controls. No VITE_ prefix. Restart/redeploy API after changes.
# The current parser implements only v3 writes; never label it v2.
PROGRAM_ANALYSIS_WRITE_VERSION=stored-program-3
PROGRAM_REVIEW_VERSION=stored-program-3
PROGRAM_SEARCH_VERSION=stored-program-2
PROGRAM_ANALYSIS_SCHEDULE_ENABLED=false

# 기존 웹 검색 서버
# 서버 전용 검색 선택: kopis(기본) 또는 supabase(확정 결과 미리보기).
# 변경 후 서버 재시작. Vercel에서는 서버 환경변수에 설정합니다.
CONCERT_SEARCH_BACKEND=kopis
# 6시간. 개발·운영 API와 브라우저 검색 캐시에 적용합니다.
CONCERT_CACHE_TTL_MS=21600000
PORT=3000
HOST=0.0.0.0

# 두 OCR 엔진이 공통으로 사용하는 이미지 제한
OCR_MAX_IMAGE_BYTES=6000000
OCR_MAX_IMAGE_PIXELS=12000000
OCR_DOWNLOAD_TIMEOUT_MS=10000

# 기존 Tesseract: 사용자 요청 기반 OCR 검색
CONCERT_INITIAL_CHECK_LIMIT=10
CONCERT_MORE_CHECK_LIMIT=10
# 로컬 Node 서버용. Vercel 함수에서는 자동으로 임시 디렉터리를 사용합니다.
CONCERT_OCR_CACHE_DIR=.cache/ocr
CONCERT_OCR_CACHE_TTL_MS=21600000
OCR_MAX_IMAGES_PER_CONCERT=8
OCR_TIMEOUT_MS=35000
# 선택: eng/kor.traineddata.gz 파일이 있는 로컬 모델 디렉터리
# TESSERACT_LANG_PATH=

# 로컬 EasyOCR 배치: 기본 Windows .venv/Scripts/python.exe, 그 외 .venv/bin/python
# EASYOCR_PYTHON=
# Git에서 제외할 로컬 모델·임시 이미지 디렉터리
# EASYOCR_CACHE_DIR=.cache/easyocr
# 이미지당 1000~900000ms. 첫 모델 초기화 시간 포함
# EASYOCR_TIMEOUT_MS=180000
