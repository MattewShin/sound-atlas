    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/index.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "fast-xml-parser": "^5.11.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "jsdom": "^27.4.0",
    "vite": "^6.0.0"
