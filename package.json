{
  "name": "sound-atlas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node scripts/test.mjs",
    "test:social": "node scripts/testMusicSocial.mjs",
    "test:retirement": "node --test server/ocrRetirement.test.mjs server/programText.test.mjs server/programTextCoordinator.test.mjs",
    "verify:retirement": "node scripts/verifyOcrRetirement.mjs",
