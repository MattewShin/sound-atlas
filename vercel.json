{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "node_modules/{tesseract.js,tesseract.js-core,bmp-js,is-url,regenerator-runtime,wasm-feature-detect,node-fetch,whatwg-url,tr46,webidl-conversions}/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__concertPath=:path*" }
  ]
}
